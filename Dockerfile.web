# trtCRM web app (Vite/React) served by nginx; /api and /s are proxied to the API container.
FROM node:22-bookworm-slim AS build
WORKDIR /app
# the web app imports shared code from ../src/lib/crm, so the whole project is the build context
COPY src/lib/crm ./src/lib/crm
COPY web ./web
WORKDIR /app/web
RUN npm ci
ARG SOURCE_COMMIT=
ENV SOURCE_COMMIT=$SOURCE_COMMIT
RUN NODE_OPTIONS=--max-old-space-size=3072 npx vite build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web/build /usr/share/nginx/html
EXPOSE 80
