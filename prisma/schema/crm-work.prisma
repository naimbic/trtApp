// ============================================================================
// Perfex CRM port — WORK domain: projects, tasks, timers, timesheets module.
// Conventions: docs/perfex/ARCHITECTURE.md. Cross-domain ids (staff, clients,
// contacts, invoices...) are plain ObjectId strings WITHOUT @relation.
// ============================================================================

// ---------------------------------------------------------------- PROJECTS --

model CrmProject {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  legacyId           Int?
  name               String
  description        String?
  /// 1 not started, 2 in progress, 3 on hold, 4 cancelled, 5 finished
  status             Int       @default(1)
  clientId           String?   @db.ObjectId
  /// 1 fixed rate, 2 project hours, 3 task hours
  billingType        Int       @default(1)
  startDate          DateTime?
  deadline           DateTime?
  dateFinished       DateTime?
  progress           Int       @default(0)
  progressFromTasks  Boolean   @default(true)
  projectCost        Float?
  projectRatePerHour Float?
  estimatedHours     Float?
  addedFrom          String?   @db.ObjectId
  contactNotification Int      @default(1)
  notifyContacts     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  members     CrmProjectMember[]
  files       CrmProjectFile[]
  discussions CrmProjectDiscussion[]
  notes       CrmProjectNote[]
  activities  CrmProjectActivity[]
  settings    CrmProjectSetting[]
  milestones  CrmMilestone[]

  @@index([clientId])
  @@index([status])
  @@index([addedFrom])
  @@index([legacyId])
  @@map("crm_projects")
}

model CrmProjectMember {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  legacyId  Int?
  projectId String     @db.ObjectId
  staffId   String     @db.ObjectId
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  project   CrmProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([staffId])
  @@map("crm_project_members")
}

model CrmProjectFile {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  legacyId          Int?
  projectId         String     @db.ObjectId
  fileName          String
  subject           String?
  description       String?
  fileType          String?
  lastActivity      DateTime?
  visibleToCustomer Boolean    @default(false)
  staffId           String?    @db.ObjectId
  contactId         String?    @db.ObjectId
  external          String?
  externalLink      String?
  thumbnailLink     String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  project           CrmProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([staffId])
  @@map("crm_project_files")
}

model CrmProjectDiscussion {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  legacyId     Int?
  projectId    String     @db.ObjectId
  subject      String
  description  String?
  showToCustomer Boolean  @default(false)
  lastActivity DateTime?
  staffId      String?    @db.ObjectId
  contactId    String?    @db.ObjectId
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  project      CrmProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("crm_project_discussions")
}

/// discussionType 'regular' => discussionId is a CrmProjectDiscussion, 'file' => a CrmProjectFile (polymorphic, no relation)
model CrmProjectDiscussionComment {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  legacyId       Int?
  discussionId   String?   @db.ObjectId
  discussionType String
  parentId       String?   @db.ObjectId
  modified       DateTime?
  content        String?
  staffId        String?   @db.ObjectId
  contactId      String?   @db.ObjectId
  fullName       String?
  fileName       String?
  fileMimeType   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([discussionId, discussionType])
  @@index([parentId])
  @@map("crm_project_discussion_comments")
}

model CrmProjectNote {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  legacyId  Int?
  projectId String     @db.ObjectId
  content   String?
  staffId   String?    @db.ObjectId
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  project   CrmProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([staffId])
  @@map("crm_project_notes")
}

model CrmProjectActivity {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  legacyId          Int?
  projectId         String     @db.ObjectId
  staffId           String?    @db.ObjectId
  contactId         String?    @db.ObjectId
  fullName          String?
  visibleToCustomer Boolean    @default(false)
  descriptionKey    String?
  additionalData    String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  project           CrmProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("crm_project_activity")
}

model CrmProjectSetting {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  legacyId  Int?
  projectId String     @db.ObjectId
  name      String
  value     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  project   CrmProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("crm_project_settings")
}

model CrmMilestone {
  id                       String     @id @default(auto()) @map("_id") @db.ObjectId
  legacyId                 Int?
  name                     String
  description              String?
  descriptionVisibleToCustomer Boolean @default(false)
  dueDate                  DateTime?
  projectId                String     @db.ObjectId
  color                    String?
  milestoneOrder           Int        @default(0)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  project                  CrmProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("crm_milestones")
}

// ------------------------------------------------------------------- TASKS --

model CrmTask {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  legacyId           Int?
  name               String
  description        String?
  /// 1 low, 2 medium, 3 high, 4 urgent
  priority           Int       @default(2)
  startDate          DateTime?
  dueDate            DateTime?
  dateFinished       DateTime?
  addedFrom          String?   @db.ObjectId
  isAddedFromContact Boolean   @default(false)
  /// 1 not started, 2 awaiting feedback, 3 testing, 4 in progress, 5 complete
  status             Int       @default(1)
  recurringType      String?
  repeatEvery        Int       @default(0)
  recurring          Boolean   @default(false)
  /// id of the task this one was generated from (recurring)
  isRecurringFrom    String?   @db.ObjectId
  cycles             Int       @default(0)
  totalCycles        Int       @default(0)
  customRecurring    Boolean   @default(false)
  lastRecurringDate  DateTime?
  /// project, customer, lead, invoice, proposal, ticket, expense, estimate, contract, credit_note, subscription, or '' (none)
  relType            String?
  relId              String?   @db.ObjectId
  isPublic           Boolean   @default(false)
  billable           Boolean   @default(false)
  billed             Boolean   @default(false)
  invoiceId          String?   @db.ObjectId
  hourlyRate         Float     @default(0)
  milestoneId        String?   @db.ObjectId
  kanbanOrder        Int       @default(0)
  milestoneOrder     Int       @default(0)
  /// the task this one is a subtask of
  parentId           String?   @db.ObjectId
  visibleToClient    Boolean   @default(false)
  deadlineNotified   Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignees      CrmTaskAssigned[]
  followers      CrmTaskFollower[]
  comments       CrmTaskComment[]
  checklistItems CrmTaskChecklistItem[]
  timers         CrmTaskTimer[]

  @@index([status])
  @@index([relType, relId])
  @@index([milestoneId])
  @@index([parentId])
  @@index([addedFrom])
  @@index([invoiceId])
  @@index([dueDate])
  @@index([legacyId])
  @@map("crm_tasks")
}

model CrmTaskAssigned {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  legacyId              Int?
  taskId                String   @db.ObjectId
  staffId               String   @db.ObjectId
  assignedFrom          String?  @db.ObjectId
  isAssignedFromContact Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  task                  CrmTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([staffId])
  @@map("crm_task_assigned")
}

model CrmTaskFollower {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  legacyId  Int?
  taskId    String   @db.ObjectId
  staffId   String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      CrmTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([staffId])
  @@map("crm_task_followers")
}

model CrmTaskComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  legacyId  Int?
  taskId    String   @db.ObjectId
  content   String?
  staffId   String?  @db.ObjectId
  contactId String?  @db.ObjectId
  fileId    String?  @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      CrmTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([staffId])
  @@map("crm_task_comments")
}

/// Source table: task_checklist_items
model CrmTaskChecklistItem {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  legacyId     Int?
  taskId       String    @db.ObjectId
  description  String?
  finished     Boolean   @default(false)
  addedFrom    String?   @db.ObjectId
  finishedFrom String?   @db.ObjectId
  listOrder    Int       @default(0)
  /// staff id the item is assigned to
  assigned     String?   @db.ObjectId
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  task         CrmTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("crm_task_checklist_items")
}

/// Source table: checklist_templates (Perfex 3.x; reusable checklist item descriptions)
model CrmChecklistTemplate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  legacyId    Int?
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("crm_checklist_templates")
}

/// Source table: taskstimers. start/end are UNIX timestamps in Perfex; stored as DateTime here.
model CrmTaskTimer {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  legacyId   Int?
  taskId     String    @db.ObjectId
  startTime  DateTime?
  endTime    DateTime?
  staffId    String?   @db.ObjectId
  hourlyRate Float     @default(0)
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  task       CrmTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([staffId])
  @@index([startTime])
  @@map("crm_taskstimers")
}

// ------------------------------------------------- TIMESHEETS MODULE (best effort) --
// Column sets of the timesheets module are not certain; unrecognised columns
// are preserved in `extra` by the importer.

/// Source table: timesheets_timesheet (daily attendance value per staff)
model CrmTimesheet {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  legacyId  Int?
  staffId   String?   @db.ObjectId
  dateWork  DateTime?
  value     String?
  addedFrom String?   @db.ObjectId
  type      String?
  relateId  String?
  extra     Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([staffId])
  @@index([dateWork])
  @@map("crm_timesheets_timesheet")
}

/// Source table: timesheets_requisition_leave
model CrmLeaveRequest {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  legacyId     Int?
  subject      String?
  staffId      String?   @db.ObjectId
  startTime    DateTime?
  endTime      DateTime?
  reason       String?
  status       Int?
  numberOfDays Float?
  extra        Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([staffId])
  @@index([status])
  @@map("crm_timesheets_requisition_leave")
}

/// Source table: timesheets_day_off (holidays / company days off)
model CrmDayOff {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  legacyId  Int?
  reason    String?
  offDate   DateTime?
  extra     Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([offDate])
  @@map("crm_timesheets_day_off")
}

// ==================== ISSUE TRACKER ====================
// Problems to follow on our platforms and websites (bugs, improvements, requests), with comments and a history.
model CrmPlatform {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  url         String?
  /// website | platform | app | other
  kind        String   @default("website")
  clientId    String?  @db.ObjectId
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("crm_platform")
}

model CrmIssue {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  number      Int
  title       String
  description String?
  /// open | in_progress | in_review | resolved | closed
  status      String    @default("open")
  /// low | medium | high | critical
  priority    String    @default("medium")
  /// bug | improvement | feature | question
  type        String    @default("bug")
  labels      String[]
  platformId  String?   @db.ObjectId
  pageUrl     String?
  reporterId  String?   @db.ObjectId
  assigneeIds String[]  @db.ObjectId
  dueDate     DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([platformId])
  @@index([number])
  @@map("crm_issue")
}

/// kind = comment (body is the text) or event (meta describes the change: { field, from, to })
model CrmIssueComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  issueId   String   @db.ObjectId
  staffId   String?  @db.ObjectId
  kind      String   @default("comment")
  body      String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
  @@map("crm_issue_comment")
}

/// A reusable task: its description, checklist and subtasks (JSON), with due dates as a number of days after it is used.
model CrmTaskTemplate {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  priority     Int      @default(2)
  billable     Boolean  @default(false)
  dueInDays    Int      @default(0)
  /// JSON: ["step", ...]
  checklistRaw String?
  /// JSON: [{ name, priority, dueInDays }]
  subtasksRaw  String?
  addedFrom    String?  @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("crm_task_templates")
}

/// Quick notes of a team member: just a title and a description, listed next to the tasks. Private to their author.
model CrmQuickNote {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  addedFrom   String?  @db.ObjectId // staff
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([addedFrom])
  @@map("crm_quick_notes")
}

/// One row per team member per day (company time zone): when the CRM was first and last used that day and for how long they were active.
model CrmWorkDay {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  staffId       String   @db.ObjectId
  /// YYYY-MM-DD on the company clock
  day           String
  firstSeen     DateTime
  lastSeen      DateTime
  activeSeconds Int      @default(0)
  pings         Int      @default(0)

  @@unique([staffId, day])
  @@index([day])
  @@map("crm_work_days")
}

/// A payment made to a team member: the monthly salary, a bonus, an advance... (payroll, super admins only)
model CrmStaffPayment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  staffId    String   @db.ObjectId
  /// the month it is for, YYYY-MM
  month      String
  amount     Float
  currencyId String?  @db.ObjectId
  paidDate   DateTime
  /// salary | bonus | advance | other
  kind       String   @default("salary")
  method     String?
  note       String?
  addedBy    String?  @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([staffId])
  @@index([month])
  @@map("crm_staff_payments")
}

/// A task status (the board columns). The first five codes (1 not started, 2 awaiting feedback, 3 testing, 4 in progress, 5 complete)
/// come with the app; 1, 4 and 5 are used by the app itself (new tasks, timers, completed) and cannot be deleted. New ones get the next code.
model CrmTaskStatus {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  code        Int     @unique
  name        String
  color       String?
  statusOrder Int     @default(0)
  /// the status of a new task
  isDefault   Boolean?
  /// off: not offered for tasks and no board column while empty
  isActive    Boolean?

  @@map("crm_task_statuses")
}
