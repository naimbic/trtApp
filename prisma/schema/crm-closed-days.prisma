/// A period when the team takes no appointments (holiday, out of office). Days are calendar days in the company time zone, YYYY-MM-DD.
model CrmClosedDay {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fromDay   String
  toDay     String
  label     String?
  /// empty = the whole team is closed; otherwise only these people cannot take meetings in the period
  staffIds  String[] @db.ObjectId
  createdBy String?  @db.ObjectId
  createdAt DateTime @default(now())

  @@index([toDay])
  @@map("crm_closed_days")
}

/// A push or a Telegram / WhatsApp message that came outside the notification hours: it waits here and goes out when the hours open.
model CrmNoticeQueue {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  staffId   String   @db.ObjectId
  /// push | channel
  kind      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([staffId])
  @@map("crm_notice_queue")
}
