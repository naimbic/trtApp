/// API access and Grow (ideas, routine, skills). All cross-domain references are plain ids, like the rest of the CRM.

/// A key that lets another program read or push data (Authorization: Bearer ...). Only the SHA-256 of the key is kept.
model CrmApiKey {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  /// the first characters of the key, to recognise it in the list
  prefix     String
  hash       String    @unique
  /// what the key may do, e.g. leads:read, leads:write, tasks:write
  scopes     String[]
  createdBy  String?   @db.ObjectId
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  lastIp     String?
  calls      Int       @default(0)
  expiresAt  DateTime?
  revokedAt  DateTime?

  @@index([createdAt])
  @@map("crm_api_keys")
}

/// One call made with a key (kept for a few weeks).
model CrmApiLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  keyId     String   @db.ObjectId
  method    String
  path      String
  status    Int
  ip        String?
  ms        Int?
  createdAt DateTime @default(now())

  @@index([keyId, createdAt])
  @@index([createdAt])
  @@map("crm_api_log")
}

/// Where the CRM tells another program that something happened (signed with the secret, HMAC SHA-256).
model CrmWebhook {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  url       String
  /// sealed at rest
  secret    String
  events    String[]
  active    Boolean   @default(true)
  createdBy String?   @db.ObjectId
  createdAt DateTime  @default(now())
  lastAt    DateTime?
  lastOk    Boolean?
  lastError String?
  failures  Int       @default(0)

  @@map("crm_webhooks")
}

model CrmWebhookDelivery {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  webhookId String   @db.ObjectId
  event     String
  ok        Boolean
  status    Int?
  ms        Int?
  error     String?
  createdAt DateTime @default(now())

  @@index([webhookId, createdAt])
  @@map("crm_webhook_deliveries")
}

/// An idea or a piece of advice for the company or the team: written by the routine (rules or AI), by someone, or pushed through the API.
model CrmGrowIdea {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  body        String?
  /// leads | sales | income | team | skills | tech | marketing | ops | other
  category    String    @default("other")
  /// daily | weekly | monthly | once
  period      String    @default("once")
  /// rule | ai | manual | api
  source      String    @default("manual")
  /// new | accepted | doing | done | dismissed
  status      String    @default("new")
  /// 1 low, 2 medium, 3 high
  priority    Int       @default(2)
  tags        String[]
  assigneeIds String[]  @db.ObjectId
  dueDate     DateTime?
  /// the task made from this idea
  taskId      String?   @db.ObjectId
  sourceUrl   String?
  /// stops the routine from writing the same advice twice
  fingerprint String?
  addedFrom   String?   @db.ObjectId
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?

  @@index([status, createdAt])
  @@index([fingerprint])
  @@map("crm_grow_ideas")
}

model CrmGrowComment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  ideaId     String   @db.ObjectId
  staffId    String?  @db.ObjectId
  authorName String?
  body       String
  createdAt  DateTime @default(now())

  @@index([ideaId, createdAt])
  @@map("crm_grow_comments")
}

/// What a team member wants to learn or certify: a certification, a language level, a course. The company can support it and pay a bonus (prime) when it is passed.
model CrmSkillGoal {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  staffId     String    @db.ObjectId
  /// certification | language | course | skill
  kind        String    @default("certification")
  title       String
  provider    String?
  /// the key in the catalog it comes from, if any
  catalogKey  String?
  url         String?
  /// planned | learning | passed | failed | dropped
  status      String    @default("planned")
  targetDate  DateTime?
  doneDate    DateTime?
  note        String?
  /// what the company pays for the exam or the course
  supportAmount Float?
  /// the bonus promised when it is passed
  primeAmount   Float?
  primePaid     Boolean   @default(false)
  primePaidAt   DateTime?
  approved      Boolean   @default(false)
  approvedBy    String?   @db.ObjectId
  /// when a manager approved it (set by the server)
  approvedAt    DateTime?
  /// when it first became "passed" (set by the server, never typed)
  passedAt      DateTime?
  /// a manager checked the certificate: only a verified goal counts for the monthly prime
  verified      Boolean?
  verifiedAt    DateTime?
  verifiedBy    String?   @db.ObjectId
  createdBy     String?   @db.ObjectId
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([staffId, status])
  @@map("crm_skill_goals")
}

/// What was paid as monthly prime to one member for one month (at most one row per member and month).
model CrmGrowPrime {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  staffId    String    @db.ObjectId
  /// YYYY-MM
  month      String
  goalIds    String[]  @db.ObjectId
  count      Int       @default(0)
  /// what the rule gave at the last payment
  amount     Float     @default(0)
  paidAmount Float     @default(0)
  paidAt     DateTime?
  paidBy     String?   @db.ObjectId
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([staffId, month])
  @@map("crm_grow_primes")
}

/// An app that signs its team in with the CRM account (OpenID Connect): the Meet app, for instance.
model CrmOauthClient {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  clientId     String    @unique
  /// SHA-256 of the secret; the secret itself is shown once
  secretHash   String
  redirectUris String[]
  logoutUris   String[]
  active       Boolean   @default(true)
  createdBy    String?   @db.ObjectId
  lastUsedAt   DateTime?
  logins       Int       @default(0)
  createdAt    DateTime  @default(now())

  @@map("crm_oauth_clients")
}

/// A one-time authorization code (60 seconds), stored as a hash.
model CrmOauthCode {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  codeHash    String   @unique
  clientId    String
  userId      String   @db.ObjectId
  redirectUri String
  challenge   String?
  nonce       String?
  scope       String
  authTime    DateTime
  expiresAt   DateTime

  @@index([expiresAt])
  @@map("crm_oauth_codes")
}

/// A message the CRM posts in the team chat by itself, once or repeating (announcements, reminders, rules, the weekly meeting).
model CrmScheduledMessage {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  body       String
  /// tips | reminders | meetings | announcements | celebrations | other: how the list is grouped
  category   String?
  /// team (the Team room) | admins | all | selected: the last three are a private message to each person
  audience   String    @default("team")
  staffIds   String[]  @db.ObjectId
  /// none | daily | weekdays | weekly | monthly
  repeat     String    @default("none")
  /// custom repeat: every N day | week | month | year; cycles = how many times in all (0 = for ever); runs = how many times it went out by the schedule
  every      Int       @default(1)
  unit       String    @default("day")
  cycles     Int       @default(0)
  runs       Int       @default(0)
  /// the first moment, then the next one
  nextAt     DateTime?
  active     Boolean   @default(true)
  lastSentAt DateTime?
  lastCount  Int       @default(0)
  sentCount  Int       @default(0)
  createdBy  String?   @db.ObjectId
  /// the message as written in the rich editor (clean HTML with screenshots); body keeps the plain text
  rich       String?
  /// team assigned (told when it goes out), a client linked to it (and emailed), a task made at each send
  assigneeIds String[] @db.ObjectId
  clientId   String?   @db.ObjectId
  leadId     String?   @db.ObjectId
  emailClient Boolean  @default(false)
  makeTask   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([active, nextAt])
  @@map("crm_scheduled_messages")
}

/// A trophy a team member won by learning (first certificate, polyglot, AI ready...), with its prize in MAD and whether it was paid.
model CrmTrophy {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  staffId   String    @db.ObjectId
  key       String
  prize     Float     @default(0)
  awardedAt DateTime  @default(now())
  paid      Boolean   @default(false)
  paidAt    DateTime?
  paidBy    String?   @db.ObjectId

  @@unique([staffId, key])
  @@map("crm_trophies")
}
